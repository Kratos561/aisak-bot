# =============================================================================
# AISAK v2 — Variables de entorno
# Copia este archivo a .env (local) o configura estas claves en Render.
# =============================================================================

# --- Discord (OBLIGATORIO) --------------------------------------------------
# Token del bot desde https://discord.com/developers/applications/<your_app>/bot
DISCORD_TOKEN=

# IDs de servidores donde sincronizar slash commands inmediatamente al arrancar
# (separados por coma). Los comandos globales tardan ~1h en propagarse; con
# esto los tienes disponibles en <5s en tus servidores de prueba.
# Para obtener el ID: activa Modo Desarrollador en Discord (Ajustes > Avanzados),
# click derecho en el servidor > Copiar ID.
TEST_GUILD_IDS=

# --- YouTube OAuth (OBLIGATORIO para que funcione el audio) -----------------
# Refresh token + credenciales de una app Google "burner" dedicada. Sin esto,
# el bot funciona en modo anonimo y muere tras ~30 reproducciones/hora por
# rate-limit.
#
# Como obtenerlos:
#   1. Crea una cuenta Google nueva (NO uses tu cuenta personal).
#      - Si pide verificar telefono, usa un numero temporal de sms-activate.org
#        ($0.10). Nunca uses tu numero real.
#   2. Crea un proyecto OAuth en https://console.cloud.google.com/
#      - APIs & Services > Enable APIs > habilita "YouTube Data API v3"
#      - Credentials > Create OAuth client ID > Desktop app
#      - Anota el Client ID y Client Secret
#   3. En tu PC, ejecuta:
#        python scripts/get_oauth.py
#      Sigue las instrucciones del script. El script imprime un refresh_token.
#      Pegalo aqui (y asegurate de que Client ID/Secret coincidan).
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# --- Configuracion general (OPCIONAL — defaults sanos) ---------------------
# Color de los embeds del bot en formato 0xRRGGBB.
BOT_COLOR=0x1f77b4
# Volumen inicial (0-100).
DEFAULT_VOLUME=70
# Maximo de canciones en cola.
MAX_QUEUE_LENGTH=100
# Segundos de inactividad antes de que el bot se desconecte solo.
INACTIVITY_TIMEOUT=300
# Nivel de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Tuning de extraccion (OPCIONAL) ----------------------------------------
# Cantidad de resultados a devolver por busqueda.
SEARCH_LIMIT=5
# Timeout (segundos) para una extraccion yt-dlp o youtube-plugin.
EXTRACT_TIMEOUT=25
# Circuit breaker: fallos consecutivos antes de cambiar a fallback yt-dlp.
BREAKER_THRESHOLD=3
# Cooldown del circuit breaker (segundos).
BREAKER_COOLDOWN=60

# --- Lavalink interno (NO TOCAR salvo debug) --------------------------------
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass